<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width, initial-scale=1.0,
               maximum-scale=1.0, user-scalable=no">

<title>PAT Client - Download</title>

<meta name="description"
      content="Download PAT Client for Android">

<style>
* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

html,
body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;
    background: #0b1020;
    color: #fff;
}

body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.container {
    width: 100%;
    max-width: 430px;
}

.card {
    width: 100%;
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 28px;
    padding: 32px 22px 24px;
    text-align: center;
    box-shadow:
        0 20px 60px rgba(0,0,0,.35);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
}

/* Logo */
.logo {
    width: 82px;
    height: 82px;
    margin: 0 auto 20px;

    border-radius: 22px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: linear-gradient(
        135deg,
        #3b82f6,
        #6366f1
    );

    box-shadow:
        0 12px 30px rgba(59,130,246,.35);

    font-size: 34px;
    font-weight: 900;
}

h1 {
    margin: 0;
    font-size: 29px;
    line-height: 1.15;
    letter-spacing: -.5px;
}

.subtitle {
    margin: 12px 0 25px;
    color: #aab3c5;
    font-size: 15px;
    line-height: 1.5;
}

/* Download button */
.download {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    width: 100%;
    min-height: 58px;

    border-radius: 16px;

    background: linear-gradient(
        135deg,
        #2563eb,
        #4f46e5
    );

    color: white;
    text-decoration: none;

    font-size: 17px;
    font-weight: 800;

    box-shadow:
        0 10px 25px rgba(37,99,235,.30);

    transition:
        transform .15s ease,
        opacity .15s ease;
}

.download:active {
    transform: scale(.97);
    opacity: .9;
}

.download-icon {
    font-size: 23px;
}

/* File information */
.info {
    margin-top: 18px;

    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 10px;
}

.info-box {
    padding: 12px 8px;

    background: rgba(255,255,255,.05);
    border-radius: 13px;
}

.info-title {
    font-size: 11px;
    color: #8d98ad;
    text-transform: uppercase;
    letter-spacing: .5px;
}

.info-value {
    margin-top: 3px;
    font-size: 13px;
    font-weight: 700;
}

/* Messenger notice */
.notice {
    margin-top: 20px;
    padding: 15px;

    border-radius: 15px;

    background: rgba(255,255,255,.045);

    color: #b8c0d0;
    font-size: 13px;
    line-height: 1.5;

    text-align: left;
}

.notice strong {
    color: white;
}

/* Installation */
.install {
    margin-top: 22px;
    text-align: left;
}

.install h2 {
    margin: 0 0 10px;
    font-size: 16px;
}

.install ol {
    margin: 0;
    padding-left: 21px;

    color: #aab3c5;

    font-size: 13px;
    line-height: 1.65;
}

.install li {
    margin-bottom: 4px;
}

.footer {
    margin-top: 22px;

    color: #69758b;

    font-size: 11px;
}
</style>
</head>

<body>

<div class="container">

    <div class="card">

        <div class="logo">
            PAT
        </div>

        <h1>
            PAT Client
        </h1>

        <p class="subtitle">
            Download and install the latest PAT Client
            for your Android device.
        </p>

        <a
            class="download"
            href="https://pat-server.shop/apk/patclient-release.apk"
            download="patclient-release.apk"
        >
            <span class="download-icon">⬇</span>
            Download PAT Client
        </a>

        <div class="info">

            <div class="info-box">
                <div class="info-title">
                    Platform
                </div>

                <div class="info-value">
                    Android
                </div>
            </div>

            <div class="info-box">
                <div class="info-title">
                    File
                </div>

                <div class="info-value">
                    APK
                </div>
            </div>

        </div>

        <div class="notice">
            <strong>Opening this from Messenger?</strong><br>
            Tap the download button above. If the download
            does not start, open the browser menu and choose
            <strong>Open in browser</strong>, then tap
            <strong>Download PAT Client</strong> again.
        </div>

        <div class="install">

            <h2>
                Installation
            </h2>

            <ol>
                <li>
                    Tap <strong>Download PAT Client</strong>.
                </li>

                <li>
                    Wait for the APK to finish downloading.
                </li>

                <li>
                    Open the downloaded APK.
                </li>

                <li>
                    If Android asks for permission to install
                    unknown apps, allow your browser/file manager.
                </li>

                <li>
                    Tap <strong>Install</strong>.
                </li>
            </ol>

        </div>

        <div class="footer">
            PAT Client • Android APK
        </div>

    </div>

</div>

</body>
</html>
